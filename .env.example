# ─── Cretassic Hostal — E2E Environment Variables ────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Public landing page
BASE_URL=https://cretassichostal.com

# Admin panel
ADMIN_URL=https://cretassic-hostal.vercel.app

# Test credentials (use a dedicated test account — never production admin)
TEST_EMAIL=
TEST_PASSWORD=

# Browser options
HEADLESS=true
SLOW_MO=0

# Optional: Supabase service key for DB cleanup after tests
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
